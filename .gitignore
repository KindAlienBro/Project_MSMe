# ========================
# Project MSMe - Root .gitignore
# ========================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
env/
venv/
.venv/
ENV/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Environment variables ---
.env
.env.*
!.env.example

# --- Database dumps & backups ---
*.sql
*.backup
*.dump

# --- Credentials (sensitive) ---
*_credentials.txt

# --- Logs ---
*.log

# --- Compiled / cached ---
*.tsbuildinfo
.next/
out/

# --- Misc ---
*.pem
.vercel
